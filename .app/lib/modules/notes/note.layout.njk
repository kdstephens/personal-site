---js
{
  layout: "core/base.layout.njk",
  permalink: function({ page, app }) {
    const url = this.slugifyPath(page.filePathStem).replace(/\/index$/, '');
    const isRoot = url === "";
    if (isRoot) return "/";

    const pathPrefix = app.notes.pathPrefix.replace(/^\/|\/$/, '');
    return `/${[pathPrefix, url].filter(Boolean).join('/')}/`;
  }
}
---

<div class="page" data-pagefind-body>
  <main class="page__main" id="app-content" >
    <article>
      {% if page.filePathStem != "/index" %}
        {% set dates = page | articleDates(published, lastModified, app.lang) %}
      {% endif %}
      <header class="article-header">
        <h1 class="page__title">{{ headline or title or page.fileSlug }}</h1>
        {% if dates %}
          <p class="article-dates" data-pagefind-ignore>
            {% if dates.published %}
              <span>{{ 'article.published' | t }} <time datetime="{{ dates.published.iso }}">{{ dates.published.label }}</time></span>
            {% endif %}
            {% if dates.lastModified %}
              <span>{{ 'article.last_modified' | t }} <time datetime="{{ dates.lastModified.iso }}">{{ dates.lastModified.label }}</time></span>
            {% endif %}
          </p>
        {% endif %}
      </header>
      <div class="article">
        {{ content | safe }}
      </div>
    </article>

    <div class="page__nav">
      {% include 'modules/page-nav/page-nav.partial.njk' %}
    </div>
  </main>

  {% if panel %}
  <div class="page__panel" data-ref="panel">
    {% include 'modules/notes/notes-panel.partial.njk' %}
  </div>
  {% endif %}
</div>


